# Modul native di proyek ini dipakai oleh Electron, bukan Node biasa.
# Electron 30.5.1 = ABI/node module version 123, jadi prebuild-install harus
# mengambil build electron-v123-win32-x64. Tanpa ini npm mencoba node-gyp untuk
# Node 26 dan build gagal (tidak ada toolchain Visual Studio di mesin ini).
runtime=electron
target=30.5.1
build_from_source=false
